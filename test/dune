; Conformance suite against vendored cucumber/gherkin testdata.
; Detached from @runtest because it currently has known failures
; (parser permissiveness gaps + position bug in lex.ml). Run with:
;   dune build @conformance
(executable
 (name conformance)
 (libraries cucumber alcotest yojson)
 (flags
  (:standard -w -42)))

(rule
 (alias conformance)
 (deps
  (source_tree gherkin-testdata))
 (action
  (run %{exe:conformance.exe})))
