# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "PPX extension for Cucumber step definitions"
description:
  "PPX rewriter providing let%given, let%when, and let%then syntax for step definitions"
maintainer: ["cyocum@gmail.com" "timmcgil@gmail.com"]
authors: ["Christopher Guy Yocum" "Tim McGilchrist"]
license: "MIT"
homepage: "https://github.com/cucumber/cucumber.ml"
bug-reports: "https://github.com/cucumber/cucumber.ml/issues"
depends: [
  "dune" {>= "3.2"}
  "ocaml" {>= "5.0.0"}
  "ppxlib" {>= "0.32.0"}
  "cucumber" {= version}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/cucumber/cucumber.ml.git"
