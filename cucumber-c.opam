# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "C-based Gherkin parser for Cucumber.ml"
description: """
Provides a parser module using the gherkin-c library via Ctypes.Foreign bindings.
Use with Cucumber.Make(Cucumber_c.Parser) to create a Cucumber instance using the C parser instead of the pure OCaml parser."""
maintainer: ["cyocum@gmail.com" "timmcgil@gmail.com"]
authors: ["Christopher Guy Yocum" "Tim McGilchrist"]
license: "MIT"
homepage: "https://github.com/cucumber/cucumber.ml"
bug-reports: "https://github.com/cucumber/cucumber.ml/issues"
depends: [
  "dune" {>= "3.2"}
  "ocaml" {>= "5.0.0"}
  "cucumber" {= version}
  "ctypes" {>= "0.20.0"}
  "ctypes-foreign" {>= "0.20.0"}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/cucumber/cucumber.ml.git"
