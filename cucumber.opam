# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Cucumber BDD for OCaml"
description: """
Cucumber BDD for OCaml with a pure OCaml Gherkin parser.
 Uses OCaml 5.x effect handlers for running steps."""
maintainer: ["cyocum@gmail.com" "timmcgil@gmail.com"]
authors: ["Christopher Guy Yocum" "Tim McGilchrist"]
license: "MIT"
homepage: "https://github.com/cucumber/cucumber.ml"
bug-reports: "https://github.com/cucumber/cucumber.ml/issues"
depends: [
  "dune" {>= "3.2"}
  "ocaml" {>= "5.0.0"}
  "re" {>= "1.9.0"}
  "cmdliner" {>= "1.1"}
  "menhir" {>= "20180523"}
  "sedlex" {>= "2.0"}
  "ppxlib" {>= "0.32.0"}
  "alcotest" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/cucumber/cucumber.ml.git"
